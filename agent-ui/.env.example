# ========================================
# Option 2 (recommended): backend URL via environment variable
# ========================================
# Put the LAN IP of the machine hosting the backend
# (PC / local server / Raspberry Pi) on the same Wi-Fi.

VITE_BACKEND_URL=http://10.93.177.189:8000  #ignore this line, update the IP and port then create a local .env file with the correct URL.

# ========================================
# Quick notes
# ========================================
# - Start backend with: uvicorn backend.main:app --reload --host 0.0.0.0 --port 8000
# - If backend IP changes, update this value then rebuild the mobile app.
# - Keep this file as template only; create your own .env locally.

# ========================================
# Optional: Picovoice wake-word key
# ========================================
# VITE_PICOVOICE_ACCESS_KEY=your_picovoice_access_key_here
