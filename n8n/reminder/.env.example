# ═══════════════════════════════════════════════════════════════
# .env.example — GOB AI Reminder System
# Copy to .env and fill in your values:
#   cp .env.example .env
# ═══════════════════════════════════════════════════════════════

# ── Server ───────────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000

# ── n8n Integration ──────────────────────────────────────────────
# URL of the wf_set_reminder webhook node in n8n
# Get it from: n8n → Workflow → Webhook node → copy URL
N8N_WEBHOOK_REMINDER_URL=http://localhost:5678/webhook/reminder

# Timeout in seconds for n8n webhook POST
N8N_REMINDER_TIMEOUT=15

# Set to false to disable n8n (mock responses used instead)
ENABLE_N8N_INTEGRATION=true

# ── Callback (Backend URL reachable FROM n8n) ─────────────────────
# IMPORTANT: if n8n runs in Docker or on a different machine,
# replace localhost with your LAN IP or ngrok URL
# e.g. http://192.168.1.42:8000/callback/n8n
#   or https://abc123.ngrok.io/callback/n8n
BACKEND_CALLBACK_URL=http://localhost:8000/callback/n8n

# ── TTS (Piper/Wyoming — optional) ───────────────────────────────
# Set ENABLE_TTS=false to skip TTS (silent mode)
ENABLE_TTS=true
TTS_HOST=localhost
TTS_PORT=10200

# ── MQTT (ESP32 Hardware Alerts — optional) ───────────────────────
# Set ENABLE_MQTT_INTEGRATION=false to skip MQTT
ENABLE_MQTT_INTEGRATION=true
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=

# ── Defaults ─────────────────────────────────────────────────────
DEFAULT_TIMEZONE=Africa/Tunis
DEFAULT_LANGUAGE=fr

# ── Demo / Test Mode ─────────────────────────────────────────────
# DEMO_MODE=true disables ALL external calls (n8n, TTS, MQTT)
# and returns mock responses everywhere. Ideal for testing/demo.
DEMO_MODE=false
