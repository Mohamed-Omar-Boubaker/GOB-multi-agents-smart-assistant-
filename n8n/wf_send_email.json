            {
              "name": "Content-Type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={\n  \"model\": \"meta-llama/llama-4-scout-17b-16e-instruct\",\n  \"messages\": [\n    {\n      \"role\": \"system\",\n      \"content\": \"You are an email generation engine. You must generate ONLY the email body. No explanations. No examples. No questions. No extra text.\"\n    },\n    {\n      \"role\": \"user\",\n      \"content\": \"Write a short friendly email.\\nRecipient: {{$json.recipient}}\\nSubject: {{$json.subject}}\\nLanguage: {{$json.context.language}}\\nOutput only the email body.\"\n    }\n  ],\n  \"temperature\": 0.4,\n  \"max_tokens\": 120\n}",
        "options": {}
      },
