# Configuration Module LLM

# LLM Provider
LLM_PROVIDER=openai
LLM_API_KEY=your_openai_api_key_here
LLM_MODEL=gpt-3.5-turbo

# Server Configuration
LLM_HOST=0.0.0.0
LLM_PORT=5000
LLM_DEBUG=False

# LLM Parameters
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.7
LLM_TIMEOUT=30

# Logging
LLM_LOG_LEVEL=INFO
LLM_LOG_FILE=logs/llm.log
