# ==============================================================================
# Configuration Backend Python - Agent Intelligent Embarqué PCD
# Version: 1.0
# Date: 10 février 2026
# ==============================================================================

# ====================
# SERVEUR
# ====================
HOST=0.0.0.0
PORT=8000
DEBUG=True
LOG_LEVEL=INFO
ENVIRONMENT=development

# ====================
# MODULE LLM
# ====================
LLM_API_URL=http://localhost:5000
LLM_API_KEY= 
LLM_MODEL=gpt-3.5-turbo
LLM_TIMEOUT=30
LLM_MAX_TOKENS=500
LLM_TEMPERATURE=0.7

# OpenRouter API (si utilisation Mistral-7B via OpenRouter)
OPENROUTER_API_KEY= jib code min open router 

# ====================
# LANGUE PAR DÉFAUT
# ====================
# Langue par défaut pour les requêtes API (en, fr, ar)
# Modifiez cette valeur pour changer la langue de tout le système
DEFAULT_LANGUAGE=en

# FORCE la langue de réponse du LLM (en, fr, ar)
# Si vide, le LLM détecte automatiquement. Si défini, FORCE cette langue.
FORCE_LLM_RESPONSE_LANGUAGE=en

# Nombre maximum de phrases dans les réponses du LLM (1-5 recommandé)
# Plus petit = réponses plus courtes et concises
MAX_RESPONSE_SENTENCES=3

# FORCE la langue de transcription Whisper (en, fr, ar, es, de, etc.)
# Si vide, Whisper auto-détecte. Si défini, FORCE Whisper à transcrire dans cette langue.
# Recommandé: Mettre "en" pour forcer l'anglais, évite que Whisper transcrive en français par erreur
FORCE_STT_LANGUAGE=en

# ====================
# MODULE STT (Speech-to-Text)
# ====================
STT_ENGINE=whisper
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
# STT_LANGUAGE sera DEFAULT_LANGUAGE si non spécifié
# STT_LANGUAGE=en

# ====================
# MODULE TTS (Text-to-Speech)
# ====================
TTS_ENGINE=gtts
# TTS_LANGUAGE sera DEFAULT_LANGUAGE si non spécifié
# TTS_LANGUAGE=en
TTS_VOICE=female
TTS_SPEED=1.0
# Si utilisation de Piper
PIPER_MODEL_PATH=models/piper/fr_FR-upmc-medium.onnx

# ====================
# MODULE N8N
# ====================
N8N_WEBHOOK_URL=http://localhost:5678/webhook/action
N8N_API_URL=http://localhost:5678
N8N_API_KEY=
N8N_TIMEOUT=60

# ====================
# MODULE MQTT (ESP32)
# ====================
MQTT_BROKER=localhost
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_TOPIC_COMMAND=esp32/command
MQTT_TOPIC_STATUS=esp32/status
MQTT_TOPIC_AUDIO=esp32/audio
MQTT_TOPIC_ROBOT_STATE_OUT=gob/robot/state
MQTT_TOPIC_ROBOT_STATE_ACK_IN=gob/robot/state/ack
MQTT_QOS=1

# ====================
# SÉCURITÉ
# ====================
SECRET_KEY=changeme-secret-key-production-MUST-BE-SECURE
JWT_ALGORITHM=HS256
JWT_EXPIRATION=3600
HMAC_ALGORITHM=sha256

# ====================
# BASE DE DONNÉES
# ====================
DATABASE_URL=sqlite:///agent.db
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20

# ====================
# CLASSIFIER
# ====================
CLASSIFIER_METHOD=rules
CLASSIFIER_THRESHOLD=0.7
CLASSIFIER_USE_LLM_FALLBACK=True

# ====================
# LIMITES ET SÉCURITÉ
# ====================
MAX_AUDIO_SIZE_MB=10
MAX_TEXT_LENGTH=1000
MAX_RETRIES=3
REQUEST_TIMEOUT=30
RATE_LIMIT_PER_MINUTE=60

# ====================
# JOURNALISATION
# ====================
LOG_DIR=logs
LOG_FILE=logs/agent.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
LOG_FORMAT=json

# ====================
# CONFIRMATION
# ====================
CONFIRMATION_TIMEOUT=30
CONFIRMATION_AUTO_CANCEL=True

# ====================
# CORS (développement uniquement)
# ====================
CORS_ORIGINS=*
CORS_ALLOW_CREDENTIALS=True

# ====================
# FEATURES FLAGS
# ====================
ENABLE_AUDIO_PROCESSING=True
ENABLE_N8N_INTEGRATION=False
ENABLE_MQTT_INTEGRATION=False
ENABLE_CONVERSATION_HISTORY=True

# Limites
MAX_AUDIO_SIZE_MB=10
MAX_TEXT_LENGTH=1000
MAX_RETRIES=3

# Journalisation
LOG_FILE=logs/agent.log
LOG_MAX_BYTES=10485760
LOG_BACKUP_COUNT=5
